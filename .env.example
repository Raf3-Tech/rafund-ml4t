# ============================================================================
# Database (required)
# ----------------------------------------------------------------------------
# Two ways to configure — pick ONE:
#
# (A) DATABASE_URL  (recommended for any hosted DB, e.g. Supabase/RDS/Neon)
#     Takes precedence over the DB_* vars below. App, SQLAlchemy engine, and
#     Alembic migrations all read it through one code path.
#
#     RULE: DATABASE_URL MUST be URL form (postgresql://user:pass@host:port/db).
#     A libpq keyword DSN ("host=... dbname=...") is NOT supported and will fail
#     the SQLAlchemy engine / migrations. If you use DSN form and it breaks,
#     that's expected — use URL form (which is what hosted providers give you).
#
#     Supabase example (use the Session pooler / direct connection on :5432,
#     NOT the transaction pooler on :6543 — this app holds a persistent pool):
#
#     DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#
# DATABASE_URL=
#
# (B) Discrete components (fine for local Postgres). For a hosted DB that needs
#     TLS but you're not using DATABASE_URL, also set DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rafund
DB_USER=postgres
DB_PASSWORD=
# DB_SSLMODE=require   # uncomment for hosted Postgres without a full DATABASE_URL

# Binance (optional — public OHLCV works without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken (optional — public OHLCV works without keys)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# KRAKEN_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,ADA/USD,DOT/USD,LINK/USD,XRP/USD

# HTX (optional — public OHLCV works without keys)
HTX_API_KEY=
HTX_API_SECRET=
# HTX_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT,DOT/USDT,LINK/USDT,XRP/USDT

# Evaluation pair and account (prop-firm style)
EVAL_PAIR_A=BTC/USDT
EVAL_PAIR_B=ETH/USDT
ACCOUNT_SIZE=5000

# Data collection
COLLECT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT,DOT/USDT,LINK/USDT,XRP/USDT
COLLECT_START_DATE=2017-08-17

# Strategy overrides (optional)
ENTRY_THRESHOLD=2.0
EXIT_THRESHOLD=0.5
LOOKBACK=60
LEG_ALLOCATION_PCT=0.18
MAX_HOLDING_DAYS=30

# Persist backtest output to PostgreSQL (1=yes, 0=no)
SAVE_TO_DB=1

# Set to 1 to run legacy all-pair feature scan: python main.py features
RESEARCH_ALL_PAIRS=0

# ============================================================================
# LIVE TRADING — $5,000 prop account, 5× leverage
# ----------------------------------------------------------------------------
# Checklist before uncommenting:
#   1. At least one strategy shows ready_for_live=True on the leaderboard
#      (run: python main.py leaderboard)
#   2. Shadow-mode dry run looks correct in logs
#      (leave LIVE_TRADING_ENABLED commented, run: python main.py live)
#   3. API keys below have FUTURES trading permissions enabled on the exchange
#   4. Prop-firm account is funded and set to USDT-M futures / isolated margin
#
# To go live: uncomment every line in this section.
# ----------------------------------------------------------------------------
#
# --- Exchange to trade on (pick one exchange, fill in its keys) ---
# LIVE_EXCHANGE=binance
# BINANCE_API_KEY=your_binance_futures_api_key_here
# BINANCE_API_SECRET=your_binance_futures_api_secret_here
#
# LIVE_EXCHANGE=kraken
# KRAKEN_API_KEY=your_kraken_api_key_here
# KRAKEN_API_SECRET=your_kraken_api_secret_here
#
# LIVE_EXCHANGE=htx
# HTX_API_KEY=your_htx_api_key_here
# HTX_API_SECRET=your_htx_api_secret_here
#
# --- Account type and leverage ---
# LIVE_ACCOUNT_TYPE=future       # 'future' = USDT-M perps | 'margin' = spot margin | 'spot' = no leverage
# LIVE_LEVERAGE=5                # integer multiplier; must match what the prop firm allows
# LIVE_MARGIN_MODE=isolated      # 'isolated' strongly preferred — loss capped to position margin only
#
# --- Risk limits (must match prop-firm rules exactly) ---
# ACCOUNT_SIZE=5000
# MAX_DAILY_LOSS_PCT=0.03        # 3% daily loss limit  = $150 on $5K
# MAX_DRAWDOWN_PCT=0.03          # 3% max drawdown      = $150 on $5K
# LIVE_MAX_NOTIONAL_USDT=200     # hard cap per order; raise only after proven track record
#
# --- Flip the switch ---
# LIVE_TRADING_ENABLED=1         # THE MASTER SWITCH — orders are real when this is 1
