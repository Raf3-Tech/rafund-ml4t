# ============================================================================
# AWS + Supabase deployment environment — copy to .env and fill in values
# ============================================================================

# Database — individual components (preferred; handles special chars in password)
DB_HOST=db.[project-ref].supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Or use a single URL instead of the above (comment out DB_* vars if using this):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Binance API — public OHLCV works without keys; keys required for funding rates + live trading
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken API — required only for live trading on Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Prop-firm evaluation
EVAL_PAIR_A=BTC/USDT
EVAL_PAIR_B=ETH/USDT
ACCOUNT_SIZE=5000

# Binance symbols collected (comma-separated, USDT pairs)
COLLECT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT,DOT/USDT,LINK/USDT,XRP/USDT
# Kraken symbols collected (comma-separated, USD pairs — collected with --exchange kraken or --exchange all)
KRAKEN_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,ADA/USD,DOT/USD,LINK/USD,XRP/USD
COLLECT_START_DATE=2017-08-17

# Strategy parameters
ENTRY_THRESHOLD=2.0
EXIT_THRESHOLD=0.5
LOOKBACK=60
LEG_ALLOCATION_PCT=0.18
MAX_HOLDING_DAYS=30

# Prop-firm risk limits
MAX_DAILY_LOSS_PCT=0.04
MAX_DRAWDOWN_PCT=0.06
MAX_LEVERAGE=5.0

# MLflow experiment name
MLFLOW_EXPERIMENT=rafund-ml4t

# Training loop cadence — seconds between cycle starts (1800 = 30 min)
# Set to 0 for back-to-back cycles with no sleep.
LOOP_INTERVAL=1800

# Persist backtest results to PostgreSQL
SAVE_TO_DB=1

# Set to 1 to scan all symbol pairs in the feature scan (slower)
RESEARCH_ALL_PAIRS=0

# ── Live trading ─────────────────────────────────────────────────────────────
# Set to 1 ONLY when you are ready to place real orders on the exchange.
# When 0 (default) the live trader runs in shadow mode: logs decisions, no orders.
LIVE_TRADING_ENABLED=0

# Exchange for live execution: binance | kraken
LIVE_EXCHANGE=binance

# Hard cap on notional per position (USD). Prevents runaway sizing.
LIVE_MAX_NOTIONAL_USDT=200
